rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'niwansathsara76@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /units/{unitId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /customTools/{toolId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /customToolFiles/{toolId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['html','updatedAt'])
        && request.resource.data.html is string
        && request.resource.data.html.size() <= 819200;
      allow delete: if isAdmin();
    }
    match /siteVisitors/{visitorId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == visitorId);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == visitorId
        && request.resource.data.keys().hasOnly(['firstSeenAt','lastSeenAt'])
        && request.resource.data.keys().hasAll(['firstSeenAt','lastSeenAt'])
        && request.resource.data.firstSeenAt is timestamp
        && request.resource.data.lastSeenAt is timestamp;
      allow update: if signedIn() && request.auth.uid == visitorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt is timestamp;
      allow delete: if isAdmin();
    }
    match /sitePresence/{visitorId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == visitorId);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == visitorId
        && request.resource.data.keys().hasOnly(['firstSeenAt','lastSeenAt','page'])
        && request.resource.data.keys().hasAll(['firstSeenAt','lastSeenAt','page'])
        && request.resource.data.firstSeenAt is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300;
      allow update: if signedIn() && request.auth.uid == visitorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt','page'])
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == visitorId);
    }
  }
}
